          <dc:Bounds x="2240" y="444" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_bik" bpmnElement="A_bik">
        <dc:Bounds x="1320" y="540" width="150" height="80" />
