<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AsIs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gen_bpmn.py (Mateusz Biernat)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_AsIs">
    <bpmn:participant id="P_Klient" name="Klient" />
    <bpmn:participant id="P_Bank" name="Bank - obsluga wniosku kredytowego (AS-IS)" processRef="Proc_AsIs" />
    <bpmn:participant id="P_Bik" name="BIK / KRD (portal WWW)" />
    <bpmn:messageFlow id="M_a1" name="wniosek papierowy" sourceRef="P_Klient" targetRef="A_start" />
    <bpmn:messageFlow id="M_a2" name="telefon o brakach" sourceRef="A_telefon" targetRef="P_Klient" />
    <bpmn:messageFlow id="M_a3" name="reczne zapytanie przez portal" sourceRef="A_bik" targetRef="P_Bik" />
    <bpmn:messageFlow id="M_a4" name="decyzja odmowna (ustnie)" sourceRef="A_info_nie" targetRef="P_Klient" />
    <bpmn:messageFlow id="M_a5" name="umowa do podpisu" sourceRef="A_podpis" targetRef="P_Klient" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_AsIs" isExecutable="false">
    <bpmn:laneSet id="LS_Proc_AsIs">
      <bpmn:lane id="L_Doradca" name="Doradca kredytowy (oddzial)">
        <bpmn:flowNodeRef>A_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_przyjmij</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_excel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_gkomplet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_telefon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_info_nie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_umowa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_podpis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_end_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_end_nie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Analityk" name="Analityk ryzyka kredytowego">
        <bpmn:flowNodeRef>A_bik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_scoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_opinia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_glimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_dec_analityk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_gdecyzja</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Komitet" name="Komitet kredytowy">
        <bpmn:flowNodeRef>A_komitet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_start" name="Klient sklada wniosek w oddziale">
      <bpmn:documentation>Wniosek papierowy, przyjmowany wylacznie w godzinach pracy oddzialu.</bpmn:documentation>
      <bpmn:outgoing>F_Proc_AsIs_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_A_start" />
    </bpmn:startEvent>
    <bpmn:userTask id="A_przyjmij" name="Przyjmij wniosek papierowy">
      <bpmn:documentation>Doradca sprawdza wzrokowo komplet zalacznikow. Brak listy kontrolnej w systemie.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_1</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="A_excel" name="Przepisz dane do arkusza Excel">
      <bpmn:documentation>Dane przepisywane recznie z formularza papierowego. Zrodlo najczestszych bledow.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_2</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="A_gkomplet" name="Komplet dokumentow?">
      <bpmn:incoming>F_Proc_AsIs_3</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_4</bpmn:outgoing>
      <bpmn:outgoing>F_Proc_AsIs_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A_telefon" name="Zadzwon po brakujace dokumenty">
      <bpmn:documentation>Brak sladu kontaktu w systemie - ustalenia zostaja w notatniku doradcy.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_4</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A_mail" name="Wyslij wniosek e-mailem do analityka">
      <bpmn:documentation>Skan wniosku jako zalacznik. Poza e-mailem nie ma informacji, gdzie jest sprawa.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_5</bpmn:incoming>
      <bpmn:incoming>F_Proc_AsIs_6</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A_info_nie" name="Poinformuj klienta telefonicznie">
      <bpmn:documentation>Uzasadnienie decyzji przekazywane ustnie, bez zapisu.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_16</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="A_umowa" name="Przygotuj umowe w edytorze tekstu">
      <bpmn:documentation>Szablon .docx z dysku sieciowego, dane wpisywane recznie po raz drugi.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_15</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="A_podpis" name="Umow klienta na podpis umowy">
      <bpmn:incoming>F_Proc_AsIs_18</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A_end_ok" name="Umowa podpisana">
      <bpmn:incoming>F_Proc_AsIs_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A_end_nie" name="Wniosek odrzucony">
      <bpmn:incoming>F_Proc_AsIs_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A_bik" name="Pobierz raport BIK recznie">
      <bpmn:documentation>Logowanie do portalu, pobranie PDF, zapis na dysku sieciowym.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_7</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="A_scoring" name="Policz scoring w arkuszu">
      <bpmn:documentation>Arkusz lokalny, wersjonowany nazwa pliku. Kazdy analityk ma wlasna kopie.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_8</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="A_opinia" name="Sporzadz opinie o ryzyku">
      <bpmn:incoming>F_Proc_AsIs_9</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A_glimit" name="Kwota powyzej limitu analityka?">
      <bpmn:incoming>F_Proc_AsIs_10</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_11</bpmn:outgoing>
      <bpmn:outgoing>F_Proc_AsIs_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A_dec_analityk" name="Zatwierdz decyzje kredytowa">
      <bpmn:incoming>F_Proc_AsIs_12</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A_gdecyzja" name="Decyzja pozytywna?">
      <bpmn:incoming>F_Proc_AsIs_13</bpmn:incoming>
      <bpmn:incoming>F_Proc_AsIs_14</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_15</bpmn:outgoing>
      <bpmn:outgoing>F_Proc_AsIs_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A_komitet" name="Rozpatrz wniosek na komitecie">
      <bpmn:documentation>Komitet zbiera sie raz w tygodniu - wniosek czeka do najblizszego posiedzenia.</bpmn:documentation>
      <bpmn:incoming>F_Proc_AsIs_11</bpmn:incoming>
      <bpmn:outgoing>F_Proc_AsIs_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_Proc_AsIs_1" sourceRef="A_start" targetRef="A_przyjmij" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_2" sourceRef="A_przyjmij" targetRef="A_excel" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_3" sourceRef="A_excel" targetRef="A_gkomplet" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_4" name="nie" sourceRef="A_gkomplet" targetRef="A_telefon" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_5" sourceRef="A_telefon" targetRef="A_mail" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_6" name="tak" sourceRef="A_gkomplet" targetRef="A_mail" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_7" sourceRef="A_mail" targetRef="A_bik" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_8" sourceRef="A_bik" targetRef="A_scoring" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_9" sourceRef="A_scoring" targetRef="A_opinia" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_10" sourceRef="A_opinia" targetRef="A_glimit" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_11" name="tak" sourceRef="A_glimit" targetRef="A_komitet" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_12" name="nie" sourceRef="A_glimit" targetRef="A_dec_analityk" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_13" sourceRef="A_komitet" targetRef="A_gdecyzja" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_14" sourceRef="A_dec_analityk" targetRef="A_gdecyzja" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_15" name="tak" sourceRef="A_gdecyzja" targetRef="A_umowa" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_16" name="nie" sourceRef="A_gdecyzja" targetRef="A_info_nie" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_17" sourceRef="A_info_nie" targetRef="A_end_nie" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_18" sourceRef="A_umowa" targetRef="A_podpis" />
    <bpmn:sequenceFlow id="F_Proc_AsIs_19" sourceRef="A_podpis" targetRef="A_end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia_AsIs">
    <bpmndi:BPMNPlane id="Plane_AsIs" bpmnElement="Collab_AsIs">
      <bpmndi:BPMNShape id="S_P_Klient" bpmnElement="P_Klient" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2430" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_P_Bank" bpmnElement="P_Bank" isHorizontal="true">
        <dc:Bounds x="160" y="220" width="2430" height="720" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L_Doradca" bpmnElement="L_Doradca" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="2400" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L_Analityk" bpmnElement="L_Analityk" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="2400" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L_Komitet" bpmnElement="L_Komitet" isHorizontal="true">
        <dc:Bounds x="190" y="780" width="2400" height="160" />
      </bpmndi:BPMNShape>
