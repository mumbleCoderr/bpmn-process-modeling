        <di:waypoint x="1140" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Proc_AsIs_7" bpmnElement="F_Proc_AsIs_7">
        <di:waypoint x="1290" y="300" />
