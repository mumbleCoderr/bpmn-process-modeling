        <dc:Bounds x="2270" y="555" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_komitet" bpmnElement="A_komitet">
        <dc:Bounds x="2040" y="820" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_P_Bik" bpmnElement="P_Bik" isHorizontal="true">
        <dc:Bounds x="160" y="1000" width="2430" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_F_Proc_AsIs_1" bpmnElement="F_Proc_AsIs_1">
        <di:waypoint x="333" y="300" />
        <di:waypoint x="420" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Proc_AsIs_2" bpmnElement="F_Proc_AsIs_2">
        <di:waypoint x="570" y="300" />
        <di:waypoint x="600" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Proc_AsIs_3" bpmnElement="F_Proc_AsIs_3">
        <di:waypoint x="750" y="300" />
        <di:waypoint x="830" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Proc_AsIs_4" bpmnElement="F_Proc_AsIs_4">
